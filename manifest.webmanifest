{
  "name": "Yomitan PDF Viewer",
  "short_name": "Yomitan PDF",
  "description": "An offline PDF.js viewer for Yomitan dictionary lookups.",
  "id": "./",
  "start_url": "./web/",
  "scope": "./",
  "display": "standalone",
  "display_override": ["tabbed", "standalone"],
  "tab_strip": {
    "new_tab_button": {
      "url": "./web/"
    }
  },
  "background_color": "#ffffff",
  "theme_color": "#1f4b7a",
  "icons": [
    {
      "src": "icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
